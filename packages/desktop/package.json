{
  "name": "fist-desktop",
  "productName": "FIST",
  "version": "1.0.3",
  "description": "FIST -- a modern cross-platform VLESS/Trojan/Shadowsocks/Hysteria2/WireGuard client powered by sing-box",
  "main": "electron/main.cjs",
  "author": "FIST",
  "license": "MIT",
  "scripts": {
    "build:ui": "vite build",
    "start": "npm run build:ui && electron .",
    "dev": "vite build && electron .",
    "dist": "node scripts/build-exe.cjs",
    "dist:publish": "node scripts/build-exe.cjs --publish",
    "dist:portable": "node scripts/build-exe.cjs --portable",
    "dist:mac": "node scripts/build-exe.cjs --mac",
    "dist:linux": "node scripts/build-exe.cjs --linux"
  },
  "dependencies": {
    "@fontsource/space-mono": "^5.3.0",
    "@grpc/grpc-js": "^1.12.2",
    "@grpc/proto-loader": "^0.7.13",
    "@soul-connection/core-logic": "*",
    "dotted-map": "^3.1.0",
    "electron-updater": "^6.3.9",
    "framer-motion": "^11.18.2",
    "lucide-react": "^1.28.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.fist.app",
    "productName": "FIST",
    "electronVersion": "33.4.11",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker",
      "icon": "electron/assets/icon.ico",
      "extraResources": [
        {
          "from": "bin/win32",
          "to": "bin"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "electron/assets/icon.ico",
      "uninstallerIcon": "electron/assets/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "public/icon-256.png",
      "extraResources": [
        {
          "from": "bin/darwin",
          "to": "bin"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "public/icon-256.png",
      "extraResources": [
        {
          "from": "bin/linux",
          "to": "bin"
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "UniversaiLab",
        "repo": "fist"
      }
    ]
  }
}
