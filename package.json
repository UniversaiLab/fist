{
  "name": "soul-connection-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w packages/desktop",
    "start": "npm run start -w packages/desktop",
    "build:ui": "npm run build:ui -w packages/desktop",
    "dist": "npm run dist -w packages/desktop",
    "dist:publish": "npm run dist:publish -w packages/desktop",
    "dist:portable": "npm run dist:portable -w packages/desktop",
    "dist:mac": "npm run dist:mac -w packages/desktop",
    "dist:linux": "npm run dist:linux -w packages/desktop",
    "marketplace:server": "npm run start -w packages/marketplace-server",
    "marketplace:server:dev": "npm run dev -w packages/marketplace-server"
  },
  "license": "MIT"
}
